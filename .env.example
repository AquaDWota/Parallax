# Copy to .env and fill in. Never commit .env.
VEXCEL_API_KEY=
ANTHROPIC_API_KEY=
# LLM for the planner is OPTIONAL - with no key, a scripted planner runs the same tools.
# Gemini instead: pip install langchain-google-genai, set GOOGLE_API_KEY and
# PARALLAX_MODEL=google_genai:gemini-2.5-flash
GOOGLE_API_KEY=
# Any LangChain "provider:model" string.
PARALLAX_MODEL=anthropic:claude-sonnet-5-5
# synthetic | real
PARALLAX_DATA_MODE=synthetic

# Open-source YOLO car detector (scripts.batch_yolo_counts)
PARALLAX_YOLO_WEIGHTS=yolo11s-obb.pt
PARALLAX_YOLO_CLASSES=small vehicle,large vehicle
PARALLAX_YOLO_CONF=0.25
PARALLAX_YOLO_GSD_M=0.15
# tile format for detection: png (lossless, default) or jpeg
PARALLAX_YOLO_IMAGE_FORMAT=png
# Which counts real mode uses: car_counts.csv (Vexcel sam3, default) or car_counts_yolo.csv
PARALLAX_CAR_COUNTS=car_counts.csv
